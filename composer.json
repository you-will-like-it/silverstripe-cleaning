{
    "name": "youwilllikeit/silverstripe-cleaning",
    "description": "SaaS platform for cleaning company administration — v5",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "silverstripe/recipe-cms": "^6.0",
        "silverstripe/recipe-core": "^6.0",
        "silverstripe/userforms": "^7.1",
        "phpmailer/phpmailer": "^6.8",
        "mpdf/mpdf": "^8.2",
        "symbiote/silverstripe-queuedjobs": "^6.2",
        "twilio/sdk": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10",
        "silverstripe/sqlite3": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "YouWillLikeIT\\Cleaning\\": "app/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YouWillLikeIT\\Cleaning\\Tests\\": "app/tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3"
        }
    },
    "extra": {
        "project-files-installed": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
